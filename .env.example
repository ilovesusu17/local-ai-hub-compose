# =====================================================================
# Local AI Hub Environment Configuration Template (.env.example)
# Rename this file to .env before starting: `cp .env.example .env`
# DO NOT COMMIT YOUR REAL .env TO VERSION CONTROL
# =====================================================================

# Global Timezone
TIMEZONE=Asia/Shanghai

# ---------------------------------------------------------------------
# New-API Gateway Settings
# ---------------------------------------------------------------------
NEW_API_PORT=3000
# Generate a secure random string for session encryption
NEW_API_SESSION_SECRET=replace_with_a_secure_random_session_secret_32_chars

# Optional external databases (defaults to built-in SQLite when left empty)
SQL_DSN=
REDIS_CONN_STRING=

# ---------------------------------------------------------------------
# WorkBuddy Reverse Proxy Hub
# ---------------------------------------------------------------------
WORKBUDDY_PORT=8788
WORKBUDDY_APP_KEY=replace_with_workbuddy_admin_key
WORKBUDDY_IMAGE=ghcr.io/local-hub/workbuddy2api-hub:latest

# ---------------------------------------------------------------------
# Trae Hub Settings
# ---------------------------------------------------------------------
TRAE_PORT=8791
TRAE_AUTH_TOKEN=replace_with_trae_token_secret
TRAE_IMAGE=ghcr.io/local-hub/trae2api:latest

# ---------------------------------------------------------------------
# Qoder Hub Settings
# ---------------------------------------------------------------------
QODER_PORT=8790
QODER_API_SECRET=replace_with_qoder_token_secret
QODER_IMAGE=ghcr.io/local-hub/qoder2api:latest

# ---------------------------------------------------------------------
# CLIProxy API Settings
# ---------------------------------------------------------------------
CLIPROXY_PORT=8317
CLIPROXY_SECRET=replace_with_cliproxy_secret
CLIPROXY_IMAGE=ghcr.io/local-hub/cliproxyapi:latest
